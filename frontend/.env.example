# Personal Notes Organizer - Environment Variables
# Copy this file to .env and adjust values as needed

# API Configuration (optional - defaults to localStorage if empty)
NUXT_PUBLIC_API_BASE=
NUXT_PUBLIC_BACKEND_URL=
NUXT_PUBLIC_FRONTEND_URL=http://localhost:3000
NUXT_PUBLIC_WS_URL=

# Application Configuration
NUXT_PUBLIC_NODE_ENV=development
NUXT_PUBLIC_PORT=3000
NUXT_PUBLIC_TRUST_PROXY=false

# Development Configuration
NUXT_PUBLIC_ENABLE_SOURCE_MAPS=true
NUXT_PUBLIC_LOG_LEVEL=info

# Feature Flags
NUXT_PUBLIC_FEATURE_FLAGS={}
NUXT_PUBLIC_EXPERIMENTS_ENABLED=false

# Monitoring
NUXT_PUBLIC_HEALTHCHECK_PATH=/api/healthz

# Privacy
NUXT_PUBLIC_NEXT_TELEMETRY_DISABLED=1
